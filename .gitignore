# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 예시 파일(키 이름·용도 문서화, 값 없음)은 커밋 대상
!.env.example

# KIS token/approval-key persistent cache (holds live secrets — never commit)
/.cache
*kis-token*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

.vercel

# Android TWA (Bubblewrap) — 서명 비밀·빌드 산출물은 커밋 금지
android/*.keystore
android/keystore.properties
android/.gradle/
android/build/
android/app/build/
android/*.apk
android/*.aab
android/*.idsig
android/*.log
android/*.done
.playwright-mcp/

# 오케스트레이션 스크래치 산출물 (_workspace 스크립트가 만드는 지도 PNG·경로 JSON·
# 임시 검증 계정 자격증명). 스크립트 자체는 재현을 위해 커밋하되 산출물은 제외한다.
/_workspace/out/
